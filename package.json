{
  "name": "huedoku",
  "private": true,
  "version": "1.0.0",
  "description": "Huedoku: a color Sudoku PWA",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "selftest": "tsx scripts/selftest.ts",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "preact": "11.0.0"
  },
  "devDependencies": {
    "@fontsource/caveat-brush": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "fake-indexeddb": "6.2.5",
    "gh-pages": "6.3.0",
    "subset-font": "2.9.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
